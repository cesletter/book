{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": false,
    "moduleResolution": "Bundler",
    "types": ["vitest/globals"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*.ts",
    "src/**/*.astro",
    "netlify/functions/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
